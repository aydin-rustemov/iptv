{
  "name": "validated-iptv-playlist",
  "version": "1.0.0",
  "private": true,
  "description": "Small auto-updated IPTV playlist downloader and validator",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "update": "tsx src/index.ts",
    "priority:find": "tsx src/index.ts && tsx src/audit.ts",
    "audit": "tsx src/audit.ts",
    "canlitv:discover": "tsx src/sources/canlitvAz.ts",
    "canlitv:refresh": "tsx src/index.ts",
    "channel:health": "tsx src/index.ts && tsx src/audit.ts",
    "volo:test:arb": "tsx src/volo-arb.ts"
  },
  "dependencies": {
    "ffprobe-static": "^3.1.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "playwright": "^1.62.1",
    "typescript": "5.8.3"
  }
}
